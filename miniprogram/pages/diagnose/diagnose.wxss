/* pages/diagnose/diagnose.wxss */
.diag-container {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.tip {
  font-size: 26rpx;
  color: var(--text-weak);
  background: var(--primary-light);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.field {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.picker {
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--primary-dark);
}

.img-area {
  width: 100%;
  height: 380rpx;
  background: #fff;
  border: 2rpx dashed var(--border);
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview {
  width: 100%;
  height: 100%;
}

.img-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--text-weak);
}

.plus {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 12rpx;
  color: var(--primary);
}

.ph-text {
  font-size: 26rpx;
}

.remove {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--warn);
}

.q-input {
  height: 80rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.submit-btn {
  margin-top: 8rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.submit-btn[disabled] {
  opacity: 0.5;
}

.result {
  margin-top: 36rpx;
}
