/* pages/predict/predict.wxss */
.predict-container {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.tip {
  font-size: 26rpx;
  color: var(--text-weak, #8a948f);
  background: var(--primary-light, #e8f5e9);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.field {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.picker {
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  border: 1rpx solid var(--border, #e6ebe8);
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--primary-dark, #1b5e20);
}

.hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-weak, #8a948f);
  margin-top: 10rpx;
}

.input {
  height: 80rpx;
  background: #fff;
  border: 1rpx solid var(--border, #e6ebe8);
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.submit-btn {
  margin-top: 8rpx;
  background: var(--primary, #2e7d32);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.submit-btn[disabled] {
  opacity: 0.5;
}

.result {
  margin-top: 36rpx;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.copy {
  font-size: 24rpx;
  color: var(--primary, #2e7d32);
}

.result-box {
  max-height: 720rpx;
  margin-top: 12rpx;
  background: #f7faf8;
  border-radius: 12rpx;
  padding: 16rpx;
}

.result-text {
  font-size: 24rpx;
  color: #2b3a33;
  white-space: pre-wrap;
  word-break: break-all;
  font-family: "SFMono-Regular", Consolas, Menlo, monospace;
}
