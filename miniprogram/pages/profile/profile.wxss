/* pages/profile/profile.wxss */
.profile-container {
  padding: 32rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2e7d32, #43a047);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 28rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  background: #fff;
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.info {
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  color: #fff;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.openid {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.avatar-btn {
  background: var(--primary-light, #e8f5e9);
  color: var(--primary, #2e7d32);
  font-size: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
}

.nickname-input {
  height: 80rpx;
  background: #f5f7f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.logout-btn {
  background: #fff;
  color: #d32f2f;
  border: 1rpx solid #ffcdd2;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.login-btn {
  background: var(--primary, #2e7d32);
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.tip {
  font-size: 24rpx;
  color: var(--text-weak, #8a948f);
  margin-top: 24rpx;
  padding: 0 8rpx;
}
